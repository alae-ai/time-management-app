# Server
TM_HOST=127.0.0.1
TM_PORT=4317

# Override only if you keep the database elsewhere
# TM_DB_PATH=data/tm.db

# Docker / Dokploy: container timezone. Set this to your local zone before deploying.
# TZ=Africa/Casablanca
# Docker / Dokploy: Compose sets these paths automatically.
# TM_DATA_DIR=/app/data
# TM_DB_PATH=/app/data/tm.db

# In-app chat (M4). OpenAI-compatible endpoint.
# Leave empty to keep the in-app chat disabled; the calendar and the CLI still work.
TM_LLM_BASE_URL=
TM_LLM_API_KEY=
TM_LLM_MODEL=

# Authentication
# Browser session lifetime.
TM_SESSION_DAYS=30
# Set to 1 in production (HTTPS); keep 0 for local http:// development.
TM_COOKIE_SECURE=0
# When set, the first-run admin setup screen requires this token. Generate one with:
#   openssl rand -hex 24
# Leave empty only for trusted local development.
TM_SETUP_TOKEN=
# Public origin for CORS, e.g. https://calendar.naoufalelouahabi.com
TM_PUBLIC_ORIGIN=
# Personal API token used by the tm CLI/agent. Create it in the web UI.
TM_API_TOKEN=
